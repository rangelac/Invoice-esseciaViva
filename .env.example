# demo: nenhuma transação externa; sandbox: cartões de teste; production: dinheiro real
PAYMENT_MODE=demo
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Gere uma senha forte. Obrigatória até no modo demo.
ADMIN_PASSWORD=
# Credenciais do MESMO ambiente. Nunca colocar em código ou enviar no chat.
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_SOP_CLIENT_ID=
CIELO_SOP_CLIENT_SECRET=
# Somente após homologação e configuração de HTTPS:
ENABLE_LIVE_PAYMENTS=false
