# demo: nenhuma transação externa; sandbox: cartões de teste; production: dinheiro real
PAYMENT_MODE=demo
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Gere uma senha forte. Obrigatória até no modo demo.
ADMIN_PASSWORD=
# Credenciais do MESMO ambiente. Nunca colocar em código ou enviar no chat.
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_SOP_CLIENT_ID=
CIELO_SOP_CLIENT_SECRET=
# Somente após homologação e configuração de HTTPS:
ENABLE_LIVE_PAYMENTS=false

# Conversão de moedas: habilitar apenas após homologar DCC + SOP na conta Cielo.
# DCC real é documentado somente em produção; demo simula o fluxo.
CIELO_DCC_ENABLED=false
# Taxa informada na documentação da Cielo. Confirmar antes de habilitar.
CIELO_DCC_MARKUP_PERCENT=16

# Rede Bitcoin mainnet. Nunca colocar seed ou chave privada.
BITCOIN_ADDRESS=
ENABLE_BITCOIN=false
